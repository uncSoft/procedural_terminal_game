/* A DOS/CRT look: black glass, phosphor blue frames, amber and hot-pink highlights. */

Screen {
    background: $background;
}

Toast {
    border-left: outer $accent;
    background: $panel;
}

/* --- title, intro, settings --- */

#title-wrap, #intro-wrap, #setup-wrap {
    align: center middle;
}

#splash {
    width: auto;
    color: $primary;
    text-style: bold;
}

#tagline {
    width: auto;
    margin: 1 0;
    color: $text-muted;
}

#menu {
    width: 32;
    height: auto;
}

#menu Button {
    width: 100%;
    margin-bottom: 1;
}

#narrator-info {
    width: auto;
    color: $text-muted;
    margin-top: 1;
}

#intro-box {
    width: 76;
    max-width: 100%;
    height: auto;
    border: double $warning;
    border-title-color: $warning;
    padding: 1 2;
}

#intro-hint {
    margin-top: 1;
    color: $text-muted;
}

/* Mouse players: hints and pills that do something when clicked (ui/widgets.py Clickable). */
Clickable {
    width: auto;
}

Clickable:hover {
    text-style: reverse;
}

/* The ✕ in a panel's border (ui/panels.py CloseButton), placed in code. */
#close {
    position: absolute;
    overlay: screen;
    width: 3;
    height: 1;
    color: $secondary;
    background: $surface;
}

#close:hover {
    color: $foreground;
    background: $error;
    text-style: bold;
}

.panel-action {
    margin-top: 1;
}

/* A new floor: the card on arrival (ui/panels.py FloorScreen) and the banner left in the story. */
.panel-box.floor-box {
    width: 64;
    border: double $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

.floor-box > Static {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

.floor-box > .floor-name {
    margin: 1 0;
}

.floor-header {
    width: 100%;
    height: auto;
    margin: 1 0;
    border-top: heavy $accent;
    border-bottom: heavy $accent;
    text-align: center;
    color: $accent;
}

#setup-box {
    width: 72;
    max-width: 100%;
    height: auto;
    border: double $primary;
    border-title-color: $primary;
    padding: 1 2;
}

#setup-box Label {
    margin-top: 1;
    color: $text-muted;
}

#setup-box Input, #setup-box Select {
    width: 100%;
}

#setup-status {
    margin-top: 1;
    color: $warning;
    height: auto;
}

#setup-buttons {
    height: auto;
    margin-top: 1;
}

#setup-sound {
    height: auto;
}

#setup-sound Select {
    width: 1fr;
    margin-right: 1;
}

#setup-buttons Button {
    margin-right: 2;
}

/* --- game screen --- */

#hud {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#hud.hurt {
    background: $error 45%;
}

#hud.healed {
    background: $success 30%;
}

#main {
    height: 1fr;
}

#story {
    width: 1fr;
    border: double $primary-darken-2;
    border-title-color: $primary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#sidebar {
    width: 31;
}

.panel {
    height: auto;
    border: double $primary-darken-2;
    border-title-color: $secondary;
    padding: 0 1;
}

#scene.combat {
    border: double $error;
    border-title-color: $error;
}

#map {
    height: 1fr;
}

#choices {
    height: auto;
    max-height: 13;
    border: double $secondary-darken-2;
    border-title-color: $secondary;
    padding: 0 1;
}

.choice {
    height: auto;
}

.choice:hover {
    background: $secondary 20%;
}

.player-line {
    margin-top: 1;
    color: $secondary;
    text-style: bold;
}

.narration {
    color: $foreground;
}

.mechanic {
    height: auto;
}

.system-line {
    color: $warning;
    text-style: italic;
}

.recap {
    margin-bottom: 1;
}

.card-sprite {
    width: 100%;
    height: auto;
    text-align: center;
}

.story-sprite {
    width: 100%;
    height: auto;
    margin-top: 1;
    text-align: center;
}

.loot-row {
    height: auto;
    margin-top: 1;
    align-horizontal: center;
}

.loot-card {
    width: 26;
    height: auto;
    margin: 0 1;
    border: round $success;
    border-title-color: $success;
}

.loot-card.drop {
    border: round $warning;
    border-title-color: $warning;
}

.loot-art, .loot-text {
    width: 100%;
    height: auto;
    text-align: center;
}

.story-card {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border: heavy $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#choices.scene {
    border: double $accent;
    border-title-color: $accent;
}

#secrets-list {
    padding: 1 0;
}

/* --- dice --- */

DiceScreen {
    align: center middle;
    background: $background 60%;
}

#dice-box {
    width: 76;
    height: auto;
    border: double $secondary;
    border-title-color: $secondary;
    border-title-style: bold;
    padding: 1 2;
    background: $surface;
}

#dice-box > Static {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#dice-faces {
    margin: 1 0 0 0;
}

#dice-bonuses, #dice-verdict, #dice-prompt {
    margin-top: 1;
}

#dice-fate {
    display: none;
    margin-top: 1;
}

#dice-fate:hover {
    text-style: bold reverse;
}

/* How a roll went (see ui/effects.py): the dice box keeps its colour, the story panel pulses it. */
#dice-box.tone-great, #story.tone-great {
    border: double $warning;
    border-title-color: $warning;
}

#dice-box.tone-good, #story.tone-good {
    border: double $success;
    border-title-color: $success;
}

#dice-box.tone-neutral, #story.tone-neutral {
    border: double #c8c8e0;
    border-title-color: #c8c8e0;
}

#dice-box.tone-bad, #story.tone-bad {
    border: double $error;
    border-title-color: $error;
}

#dice-box.tone-awful, #story.tone-awful {
    border: double #ff2a6d;
    border-title-color: #ff2a6d;
}

/* --- level up and panels --- */

LevelUpScreen, Panel, HelpScreen {
    align: center middle;
    background: $background 60%;
}

#levelup-box {
    width: 70;
    height: auto;
    border: double $foreground;
    border-title-style: bold;
    padding: 1 2;
    background: $surface;
}

.perk-card {
    height: auto;
    margin-top: 1;
    padding: 0 1;
}

.perk-card:hover {
    background: $panel;
}

.panel-box {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    border: double $primary;
    border-title-color: $secondary;
    padding: 1 2;
    background: $surface;
}

.panel-box.wide {
    width: 100;
    height: 32;
}

.panel-box.inventory-box {
    width: 100;
}

#inv-shelf {
    width: 65;
    height: auto;
    max-height: 34;
}

#inv-grid {
    grid-size: 3;
    grid-gutter: 0 1;
    height: auto;
}

.item-tile {
    width: 20;
    height: 11;
    border: round $primary-darken-2;
    text-align: center;
}

.item-tile.equipped {
    border: round $secondary-darken-2;
}

.item-tile:focus {
    border: round $accent;
    background: $panel;
}

#inv-side {
    width: 1fr;
    height: auto;
    padding-left: 2;
}

#inv-detail, #inv-use, #inv-hint {
    height: auto;
}

#inv-use, #inv-hint {
    width: 100%;
    margin-top: 1;
}

#beast-list {
    width: 28;
    background: $surface;
}

/* --- campfire hub --- */

#hub {
    height: 1fr;
}

#hub-left {
    width: 1fr;
    border: double $primary;
    padding: 0 1;
}

#hub-right {
    width: 1fr;
    border: double $secondary-darken-2;
    padding: 0 1;
}

.unlock-grid {
    grid-size: 3;
    grid-gutter: 1;
    height: auto;
    padding: 1 0;
}

.unlock-card {
    width: 100%;
    height: 4;
}

.unlock-card.locked {
    color: $text-muted;
    background: $panel;
}

.unlock-card.owned {
    color: $success;
}

.unlock-card.chosen {
    color: $warning;
    text-style: bold;
}

#unlock-detail {
    height: auto;
    margin: 1 0;
}

#unlock-action {
    width: 100%;
}

#campfire {
    width: 100%;
    content-align: center middle;
    text-align: center;
    margin-top: 1;
}

#void-line {
    margin: 1 0;
    text-align: center;
}

#hub-souls {
    text-align: center;
}

#legends-box {
    height: 1fr;
    border: round $primary-darken-2;
    border-title-color: $primary;
    margin-top: 1;
}

#hub-buttons {
    height: auto;
    margin-top: 1;
}

#hub-buttons Button {
    margin-right: 1;
}

/* --- end of a run --- */

EndScreen {
    align: center middle;
}

#end-box {
    width: 76;
    max-width: 100%;
    height: auto;
    border: double $secondary;
    padding: 1 2;
}

#end-box > Static {
    width: 100%;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

#end-box > .end-hint {
    height: auto;
    align-horizontal: center;
}

.end-hint > Clickable {
    margin: 0 2;
}

#end-card {
    border: round $primary-darken-2;
    padding: 0 1;
}

/* --- the debug screen (ui/debug.py) --- */

.panel-box.debug-box {
    width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0 1;
    border: double $accent;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
}

#debug-tabs {
    height: 1fr;
}

#debug-tabs TabPane {
    height: 1fr;
    padding: 0;
}

DebugTab {
    height: 1fr;
}

.debug-toolbar {
    height: auto;
    margin: 1 0 0 0;
}

.debug-toolbar Button {
    margin-right: 2;
    padding: 0 1;
    background: $panel;
}

.debug-toolbar Button:hover {
    background: $primary-darken-1;
}

.debug-toolbar Button.-primary {
    background: $primary;
}

.debug-status {
    width: 1fr;
    padding-left: 1;
}

#check-progress {
    display: none;
    width: auto;
    margin-right: 1;
}

.debug-split {
    height: 1fr;
    margin-top: 1;
}

.debug-split DataTable {
    width: 1fr;
    height: 1fr;
}

.debug-detail {
    width: 40%;
    min-width: 48;
    height: 1fr;
    border-left: tall $primary-darken-2;
    padding: 0 1;
}

LogTab .debug-detail {
    width: 60%;
}

.debug-sprite {
    height: auto;
    margin-bottom: 1;
}

#state-text, #state-tree {
    width: 1fr;
    height: 1fr;
}

#state-tree {
    border-left: tall $primary-darken-2;
    padding-left: 1;
}

#check-backend {
    width: 22;
    margin-right: 2;
}

#log-filter {
    width: 28;
    margin-right: 2;
}

#check-url {
    width: 1fr;
    margin-right: 2;
}

#check-model {
    width: 1fr;
    margin-right: 2;
}

#check-results {
    height: 1fr;
    margin-top: 1;
    border: round $primary-darken-2;
    padding: 0 1;
}

#check-history {
    height: 9;
    margin-top: 1;
}

