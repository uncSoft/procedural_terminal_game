/* A DOS/CRT look: black glass, phosphor blue frames, amber and hot-pink highlights.

   Every screen, a pop-up's too, has a class for how big the terminal is (ui/app.py PTGApp's breakpoints): -narrow
   or -wide, and -tiny, -short or -tall (below 28 rows, below 34, or from there). On a short screen boxes drop their
   blank lines and the bigger pictures shrink. */

Screen {
    background: $background;
}

ToastRack {  /* at the top right, over the room and the sidebar: never over the choices, the pad or the command line */
    dock: top;
    align: right top;
    margin-bottom: 0;
}

Toast {
    border-left: outer $accent;
    background: $panel;
}

/* --- title, intro, settings --- */

#title-wrap, #intro-wrap, #setup-wrap {
    align: center middle;
}

#splash {
    width: auto;
    color: $primary;
    text-style: bold;
}

#splash.lit {
    color: #ffffff;
}

#title-scene {
    width: auto;
    height: auto;
}

#tagline {
    width: auto;
    color: $text-muted;
}

#menu {
    width: auto;
    height: auto;
}

#menu Button {
    min-width: 14;
    margin: 0 1;
}

#run-info {
    width: auto;
    text-align: center;
    color: $text-muted;
}


#narrator-info {
    width: auto;
    color: $text-muted;
}

/* A phone held upright: the menu two by two, and the lines under it wrapped to the screen. */
.-phone #menu {
    layout: grid;
    grid-size: 2;
    grid-columns: 16 16;
    grid-rows: 3 3;
    grid-gutter: 1 0;
    width: 32;
}

.-phone #run-info, .-phone #narrator-info {
    width: 100%;
    text-align: center;
}

#intro-box {
    width: 76;
    max-width: 100%;
    height: auto;
    border: double $warning;
    border-title-color: $warning;
    padding: 1 2;
}

#intro-hint {
    margin-top: 1;
    color: $text-muted;
}

/* Mouse players: hints and pills that do something when clicked (ui/widgets.py Clickable). */
Clickable {
    width: auto;
}

Clickable:hover {
    text-style: reverse;
}

/* The ✕ in a panel's border (ui/panels.py CloseButton), placed in code: on a layer of its own, so it takes no room
   from the box (which would sit a row off the middle). */
#close {
    layer: close;
    position: absolute;
    overlay: screen;
    width: 3;
    height: 1;
    color: $secondary;
    background: $surface;
}

#close:hover {
    color: $foreground;
    background: $error;
    text-style: bold;
}

.panel-action {
    margin-top: 1;
    height: auto;
}

.panel-action .card-verb {
    width: auto;
    margin-right: 1;
}

.-short .panel-action, .-tiny .panel-action {
    margin-top: 0;
}

/* A new floor: the card on arrival (ui/panels.py FloorScreen) and the banner left in the story. Its splash art and
   the words' widths are set as it opens, for the screen (floor_card_fit): the words under the picture, or beside. */
.panel-box.floor-box {
    border: double $accent;
    border-title-color: $accent;
    border-title-style: bold;
    align-horizontal: center;
}

.panel-box.floor-box.beside {
    layout: horizontal;
}

#floor-art {
    width: auto;
    height: auto;
}

.floor-words {
    width: 100%;
    height: auto;
    align-horizontal: center;
}

.floor-box.beside .floor-words {
    margin-left: 2;
    align-vertical: middle;
}

.floor-words > Static {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

.-tiny .floor-words > Static {
    margin-bottom: 0;
}

.floor-words > .floor-name {
    margin: 1 0;
}

/* What happens in the story is marked inside its frame without frames of its own, which fought it: a bar down the
   left (your words, a character's, a moment's, a quest), or words between ornaments in the middle (a new floor, a
   secret room or a shop found, a run picked up again). */
.floor-header {  /* a new floor (game_screen.add_floor_header) */
    width: 100%;
    height: auto;
    margin: 1 0;
    text-align: center;
    color: $accent;
}

.secret-banner {  /* a floor's secret room, or a shop, found (game_screen.secret_banner) */
    width: 100%;
    height: auto;
    margin: 1 0;
    text-align: center;
}

#setup-box {
    width: 72;
    max-width: 100%;
    height: auto;
    border: double $primary;
    border-title-color: $primary;
    padding: 1 2;
}

#setup-box Label {
    margin-top: 1;
    color: $text-muted;
}

#setup-box Input, #setup-box Select {
    width: 100%;
}

#setup-status {
    margin-top: 1;
    color: $warning;
    height: auto;
}

#setup-buttons {
    height: auto;
    margin-top: 1;
}

#setup-sound {
    height: auto;
}

#setup-sound Select {
    width: 1fr;
    margin-right: 1;
}

#setup-buttons Button {
    margin-right: 2;
}

/* --- game screen --- */

#hud {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#hud.hurt {
    background: $error 45%;
}

#hud.healed {
    background: $success 30%;
}

#hud-row {
    height: 1;
}

#hud {
    width: 1fr;
}

#hud-short {
    display: none;
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $surface;
}

#hud-menu {
    display: none;
    width: 4;
    background: $surface;
    color: $secondary;
    text-style: bold;
}

#main {
    height: 1fr;
}

#left {
    width: 1fr;
}

#stage-box {  /* the room's picture over the story, shaped like a room (ui/plan.py) */
    height: auto;
}

#stage {
    width: auto;
    height: auto;
    border: round $primary-darken-2;
    border-title-color: $secondary;
    border-title-style: bold;
}

#stage.combat {
    border: round $error;
    border-title-color: $error;
}

#stage-art {
    width: auto;
    height: auto;
    text-wrap: nowrap;  /* on a terminal made smaller later, a picture is cropped, not wrapped into a mess */
    text-overflow: clip;
}

#story {
    height: 1fr;
    border: double $primary-darken-2;
    border-title-color: $primary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#side {
    height: 1fr;
}

.panel {
    height: auto;
    border: double $primary-darken-2;
    border-title-color: $secondary;
    padding: 0 1;
}

#here-strip {
    display: none;
}

#map {
    height: auto;
}

#ways {
    display: none;
    height: 1;
    padding: 0 1;
}

.way {
    width: 1fr;
    margin-right: 1;
    text-align: center;
}

#choices {
    height: auto;  /* as many lines as it needs, up to the plan's: the layout fixes the rest (ui/plan.py) */
    border: none;
    border-top: heavy $secondary-darken-2;
    border-title-color: $secondary;
    padding: 0 1;
}

.choice-line {
    height: auto;
    width: 100%;
}

#choices .choice {
    width: auto;
    margin-right: 3;
}

.more {
    color: $secondary;
    text-style: bold;
    width: auto;
}

.choice {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.choice:hover {
    background: $secondary 20%;
}

#dpad {
    width: 17;
    height: 5;
    margin: 0 0 0 6;
    border: round $secondary-darken-2;
}

.dpad-row {
    height: 1;
}

.dpad-key, .dpad-gap {
    width: 1fr;
    height: 1;
    text-align: center;
}

.dpad-key:hover {
    background: $secondary 30%;
}

.dpad-key.off:hover {
    background: transparent;
}

/* --- Here's tiles (ui/here.py) --- */

.here-line {
    height: auto;
    width: 100%;
}

.here-tile {
    padding: 0 1 1 1;
}

.here-chip {
    padding: 0;
}

.here-body {
    height: auto;
    width: 100%;
}

.here-art {
    width: auto;
    height: auto;
}

.here-words {
    width: 1fr;
    height: auto;
    padding-left: 1;
}

.here-name, .here-status {
    width: 100%;
    height: auto;
}

.here-chip .here-name {
    width: auto;
    margin-right: 1;
}

.here-verb-rows {
    height: auto;
    width: 100%;
}

.here-chip .here-verb-rows {
    width: 1fr;
}

.here-verbs {
    height: auto;
    width: 100%;
    layout: horizontal;
}

.verb {
    width: auto;
    margin-right: 1;
    height: 1;
}

.verb:hover {
    text-style: bold;
}

.pick-row, .menu-row {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

.touch .pick-row, .touch .menu-row {  /* played with a finger (Panel.on_mount): a row three tall, its words centred */
    height: 3;
    content-align: left middle;
    background: $panel;
    margin-bottom: 1;
}

/* --- the size classes the plan sets on the game screen (GameScreen.relayout) --- */

GameScreen.one #main {
    layout: vertical;
}

GameScreen.one #side {
    display: none;
}

GameScreen.one #here-strip {
    display: block;
}

GameScreen.one #ways {
    display: block;
}

GameScreen.compact #hud {
    display: none;
}

GameScreen.compact #hud-short, GameScreen.compact #hud-menu {
    display: block;
}

GameScreen.compact Footer {
    display: none;
}

GameScreen.compact #command {
    height: 1;
    border: none;
    padding: 0 1;
}

GameScreen.compact #story, GameScreen.compact #here, GameScreen.compact #here-strip,
GameScreen.compact #stage, GameScreen.compact #map {
    border: none;
    border-top: heavy $primary-darken-2;
}

GameScreen.touch .verb {
    height: 3;
    min-width: 8;
    padding: 0 1;
    margin-right: 2;
    content-align: center middle;
}

GameScreen.touch #ways {
    height: 3;
}

GameScreen.touch .way {
    height: 3;
    background: $panel;
    content-align: center middle;
}

GameScreen.touch .verb:hover, GameScreen.touch .choice:hover {
    background: transparent;
    text-style: none;
}

/* --- the game screen in tabs (ui/tabs.py): an illustrated story book, the words on the left page and the
   pictures on the right, each box in its own colour --- */

TabsScreen { background: #090a13; }
TabsScreen #left { width: 1fr; padding: 0 1 0 1; }
TabsScreen #story { border: double $primary-darken-2; border-title-color: $primary; padding: 0 2 0 1;
                    background: #0b0c18; }
TabsScreen #decide { height: 12; border: round $secondary; border-title-color: $secondary;
                     border-title-style: bold; padding: 0 1; background: #12142a; }
TabsScreen #decide.scene { border: round $accent; border-title-color: $accent; }
TabsScreen #choices { height: 1fr; border: none; padding: 0; background: #12142a; }
TabsScreen #choices .choice { width: 100%; margin: 0; }
TabsScreen #command { border: none; height: 1; background: #1c2040; padding: 0 1; }
TabsScreen #lately { height: 6; border: round #6c8cff; border-title-color: #6c8cff; padding: 0 1;
                     background: #0b0c18; text-wrap: nowrap; text-overflow: ellipsis; }
TabsScreen #lately.noted { border: round #ffd166; border-title-color: #ffd166; }
TabsScreen #command:focus { background: #23284e; }
TabsScreen #side { padding: 0 1 0 0; }
TabsScreen #stage-box { height: auto; }
TabsScreen #stage { padding: 0; }
TabsScreen #pane-head { height: 3; padding: 0 1; }
TabsScreen #dpad { width: 11; height: 3; margin: 0 2 0 0; border: none; }
TabsScreen .dpad-key, TabsScreen .dpad-gap { width: 3; }
TabsScreen #ways-words { width: 1fr; height: 3; padding: 0 0 0 1; content-align: left middle; }
TabsScreen #tab-row { height: 1; padding: 0 1; }
TabsScreen #tab-bar { width: 1fr; height: 1; }
TabsScreen #tab-expand { width: 5; height: 1; color: #6c6f99; text-align: right; }
TabsScreen #tab-expand:hover { color: #ffb000; background: #1c2040; }
TabsScreen #pane { height: 1fr; border: round #ffb000; border-title-style: bold; border-subtitle-color: #6c6f99;
                   padding: 0 1; background: #10122a; scrollbar-size-vertical: 1; scrollbar-background: #10122a;
                   scrollbar-color: #2a2d4a; }
TabsScreen #shims { display: none; }
TabsScreen ToastRack { dock: bottom; align: right bottom; }  /* in the decision's box (tabs.py) */
TabsScreen .focus { height: auto; margin-top: 1; }
TabsScreen .focus-art { margin-right: 2; width: auto; }
TabsScreen .focus-model { width: 26; height: 13; }  /* the pack's thing in focus, turning (ui/model_view.py) */
TabsScreen .focus-side { height: auto; width: 1fr; }
TabsScreen .focus-words { height: auto; }
TabsScreen .focus-verbs { height: auto; margin-top: 1; }
TabsScreen .here-verbs { height: 1; width: auto; }
TabsScreen .here-verbs .verb { width: auto; margin-right: 1; }
TabsScreen .strip { height: auto; margin-top: 1; grid-gutter: 0 1; grid-rows: auto; }
TabsScreen .thumb { width: 12; height: auto; }
TabsScreen .thumb:hover { background: #1c2040; }
TabsScreen .thumb-art { width: 12; height: auto; }
TabsScreen .thumb-mark { height: 1; width: 12; color: #10122a; }
TabsScreen .thumb.picked .thumb-mark { color: #ffb000; }
TabsScreen .plain-line { height: 1; width: auto; margin-top: 1; }
TabsScreen .plain-name { width: auto; margin-right: 1; }
TabsScreen .pane-rule { height: 1; margin: 1 0 0 0; }
TabsScreen .map-holder { width: 100%; align: center middle; }
TabsScreen .pane-map, TabsScreen .small-map { width: auto; height: auto; }
TabsScreen .pane-text { height: auto; }
TabsScreen .pane-gap { height: 1; }
TabsScreen #footer-row { dock: bottom; height: 1; background: $footer-background; }
TabsScreen #footer-row Footer { dock: none; width: 1fr; }
TabsScreen #footer-narrator { width: auto; height: 1; padding: 0 1; color: $text-muted;
                              background: $footer-background; border-left: vkey $foreground 20%; }

/* the story: a bar down the side of what you did and a faint one by the dice; the floor's, a quest's and a shop's
   banners as bands of colour */
TabsScreen .player-line { border-left: outer #ffb000; padding-left: 1; margin-top: 1; }
TabsScreen .mechanic { border-left: outer #23264a; padding-left: 1; }
TabsScreen .narration, TabsScreen .pickup-line, TabsScreen .purse-line, TabsScreen .system-line { padding-left: 2; }
TabsScreen .floor-header { border-top: none; border-bottom: none; background: #2a1030; padding: 1 0; margin: 1 0; }
TabsScreen .quest-banner { border: none; background: #2e2408; padding: 0 2; margin-top: 1; }
TabsScreen .secret-banner { border-top: none; border-bottom: none; background: #2e2408; padding: 1 0; }
TabsScreen .secret-banner.shop { border-top: none; border-bottom: none; background: #0c2a18; }
TabsScreen .continued { border-top: none; border-bottom: none; background: #141a3c; padding: 0; }

.player-line { border-left: outer #ffb000; padding-left: 1; margin-top: 1; }
TabsScreen .mechanic { border-left: outer #23264a; padding-left: 1; }
TabsScreen .narration, TabsScreen .pickup-line, TabsScreen .purse-line, TabsScreen .system-line { padding-left: 2; }
TabsScreen .floor-header { border-top: none; border-bottom: none; background: #2a1030; padding: 1 0; margin: 1 0; }
TabsScreen .quest-banner { border: none; background: #2e2408; padding: 0 2; margin-top: 1; }
TabsScreen .secret-banner { border-top: none; border-bottom: none; background: #2e2408; padding: 1 0; }
TabsScreen .secret-banner.shop { border-top: none; border-bottom: none; background: #0c2a18; }
TabsScreen .continued { border-top: none; border-bottom: none; background: #141a3c; padding: 0; }

/* The grid (ui/grid.py GridScreen): every box's height is set from the screen as it's laid out (grid.share), and
   whether the decision is beside the story or under it; these are their looks. The big buttons' frames and urgent or
   open shades are set as they're made (BigButton); hovered, each takes a tint of its own colour (grid.tint(colour,
   0.12)), on its face, inside the frame. Nothing here hovers as Clickable's reverse: a pixel icon or a coloured key
   reversed is a block of white. */
GridScreen #play { width: 1fr; }
GridScreen #stage-box { width: 100%; }
GridScreen #stage { width: 100%; height: 100%; padding: 0; }
GridScreen #band { width: 100%; }
GridScreen #story-box { border: double $primary-darken-2; border-title-color: $primary; border-subtitle-color: #6c6f99;
                        padding: 0 2 0 1; }
GridScreen #story { height: 1fr; width: 100%; align-horizontal: center; padding: 0; border: none; }
GridScreen #story > * { max-width: 100; }  /* (a line easy to read: on a wide screen, a column down the middle) */
GridScreen #command { border: none; height: 1; width: 100%; background: #1c2040; padding: 0 1; margin: 0; }
GridScreen #command:focus { background: #23284e; }
GridScreen #decide { border: round $secondary; border-title-color: $secondary; border-title-style: bold; padding: 0 1; }
GridScreen #decide.fight { border: heavy #ff4b4b; border-title-color: #ff4b4b; }
GridScreen #decide.scene { border: round $accent; border-title-color: $accent; }
GridScreen #top-row { width: 100%; height: auto; }
GridScreen #bar { width: 1fr; }
GridScreen #decide.beside #bar { width: 100%; }
GridScreen .bar-row { width: 100%; }
GridScreen .big-button { width: 1fr; margin: 0 1 0 0; border-title-align: left; border-subtitle-align: center;
                         padding: 0; }
GridScreen .big-button:last-child { margin: 0; }
GridScreen .big-button > .face { width: 1fr; height: 1fr; content-align: center middle; text-align: center; }
GridScreen .big-button.-hover.k-attack > .face { background: #281420; }
GridScreen .big-button.-hover.k-dodge > .face, GridScreen .big-button.-hover.k-rest > .face { background: #171b35; }
GridScreen .big-button.-hover.k-heal > .face { background: #132927; }
GridScreen .big-button.-hover.k-throw > .face, GridScreen .big-button.-hover.k-bomb > .face { background: #28191e; }
GridScreen .big-button.-hover.k-use > .face { background: #282423; }
GridScreen .big-button.-hover.k-flee > .face, GridScreen .big-button.-hover.k-gear > .face { background: #1c1d2e; }
GridScreen .big-button.-hover.k-search > .face { background: #152635; }
GridScreen #compass { margin: 0 0 0 1; align-horizontal: center; }
GridScreen #decide.beside #compass { margin: 1 0 0 0; }
GridScreen .ways-head { width: 100%; height: 1; }
GridScreen .compass-row { width: auto; height: auto; }
GridScreen .compass-cell { content-align: center middle; text-align: center; }
GridScreen .compass-cell.way { background: #12142a; }
GridScreen .compass-cell.wall { background: transparent; }
GridScreen .compass-cell.middle { background: #1b1f45; }
GridScreen .compass-cell.way:hover, GridScreen .compass-cell.middle:hover { background: #23284e;
                                                                           text-style: none; }
GridScreen #below { width: 100%; padding: 0; margin: 1 0 0 0; scrollbar-size-vertical: 1; }
GridScreen #picks { width: 100%; height: 2; scrollbar-size-vertical: 1; }
GridScreen .items-head { width: 100%; height: 1; }
GridScreen .items-title { width: 1fr; }
GridScreen .items-more, GridScreen .items-close { width: auto; margin: 0 0 0 1; }
GridScreen .items-none { margin: 1 0 0 0; }
GridScreen .card-row { width: 100%; height: 6; margin: 1 0 0 0; }
GridScreen .item-card { width: 1fr; height: 6; background: #12142a; margin: 0 1 0 0; }
GridScreen .item-card:last-child { margin: 0; }
GridScreen .item-card.-hover { background: #1c2040; }
GridScreen .item-card.idle { background: #0e1022; }
GridScreen .card-art { width: 13; height: 6; padding: 0 1 0 0; }
GridScreen .card-words { width: 1fr; height: 6; padding: 0 1 0 0; }
GridScreen .scene-choice { width: 100%; height: auto; border: round $accent; padding: 0 1; margin: 0 0 1 0; }
GridScreen .scene-choice:hover { background: #1c2040; border: heavy $accent; text-style: none; }
GridScreen .scene-choice.tight { border: none; padding: 0; margin: 0 0 1 0; }  /* (a line each: they all show) */
GridScreen .scene-choice.tight:hover { border: none; }
GridScreen .chip-line { height: 1; width: 100%; }
GridScreen .tray-head { width: auto; padding: 0 1 0 0; }
GridScreen .choice-chip { width: auto; margin: 0 2 0 0; }
GridScreen .choice-chip:hover { background: #1c2040; text-style: none; }
GridScreen #side { height: 1fr; padding: 0 0 0 1; }
GridScreen #map { width: 100%; border: round #6c8cff; border-title-color: #6c8cff; border-title-style: bold;
                  border-subtitle-color: #6c6f99; padding: 0 1; }
GridScreen #map-holder { height: 1fr; align: center middle; }
GridScreen #map-art { width: auto; height: auto; text-wrap: nowrap; text-overflow: clip; }
GridScreen #map-notes { width: 100%; }
GridScreen #here { width: 100%; border: round #ffb000; border-title-color: #ffb000; border-title-style: bold;
                   padding: 0 1; overflow: hidden hidden; }
GridScreen #here.fight { border: heavy #ff4b4b; border-title-color: #ff4b4b; }
GridScreen .here-head { width: 100%; height: 1; }
GridScreen #here-things, GridScreen #here-lately { width: 100%; height: auto; }
GridScreen .here-last { width: 100%; height: auto; margin: 0 0 1 0; }
GridScreen .here-line { height: auto; width: 100%; }
GridScreen .here-empty { margin: 0 0 1 0; }
GridScreen .lately { width: 100%; }
GridScreen .here-you { height: 1; }
GridScreen .duel { height: auto; margin: 1 0 1 0; }
GridScreen .duel-art { margin: 0 2 0 0; }
GridScreen .duel-words { width: 1fr; }
GridScreen .here-verbs .verb { width: auto; margin-right: 1; }
GridScreen #strip { width: 100%; }
GridScreen .panel-row { height: 3; width: 100%; }
GridScreen .panel-button { width: 1fr; height: 3; border: round #2e3566; border-title-color: #6c6f99;
                           border-title-align: right; content-align: center middle; text-align: center; margin: 0; }
GridScreen .panel-button:hover { border: round #ffb000; border-title-color: #ffb000; text-style: none; }
/* (a panel button lights its frame, with no shade: a shade under a frame shows outside its line) */
GridScreen #shims { display: none; }

/* The grid's Map panel (ui/grid.py ChartScreen): the floor's name, the chart and the notes, each centred. */
ChartScreen .chart-box { padding: 1 2; align-horizontal: center; }
ChartScreen .chart-head { width: 100%; height: auto; }
ChartScreen .chart-name { width: 100%; text-align: center; }
ChartScreen .chart-goal { width: 100%; text-align: center; margin: 0 0 1 0; }
ChartScreen .chart-rule { width: 100%; text-align: center; }
ChartScreen .chart-holder { height: 1fr; width: 100%; align: center middle; }
ChartScreen #chart { width: auto; height: auto; text-wrap: nowrap; text-overflow: clip; }
ChartScreen .chart-notes-holder { height: auto; width: 100%; align-horizontal: center; }
ChartScreen .chart-notes { width: auto; max-width: 160; }

.player-line {
    margin-top: 1;
    color: $secondary;
    text-style: bold;
}

.narration {
    color: $foreground;
}

.mechanic {
    height: auto;
}

.turn-marker {
    height: 0;
    margin: 0;
    padding: 0;
}

.pickup-line {
    color: $success;
    text-style: bold;
}

.purse-line {
    height: auto;
}

.system-line {
    color: $warning;
    text-style: italic;
}

.recap {
    margin-bottom: 1;
}

.continued {  /* where a run picked up again starts (ui/game_screen.py pick_up_again) */
    width: 100%;
    height: auto;
    margin: 1 0;
    text-align: center;
    color: $primary;
}

.panel-sprite {  /* a picture in a panel: a monster in the bestiary, a card's picture, the shopkeeper (ui/panels.py) */
    margin-bottom: 1;
}

.card-sprite {
    width: 100%;
    height: auto;
    text-align: center;
}

.say {  /* a character's words, with who is speaking first (game_screen.add_speech) */
    border-left: thick $accent;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}

.quest-banner {
    border-left: thick $secondary;
    color: $secondary;
    text-style: bold;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}

.story-card {  /* an authored moment: its name, its picture, what happens (game_screen.add_card) */
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border-left: thick $accent;
}

#choices.scene {
    border-top: heavy $accent;
    border-title-color: $accent;
}

#secrets-list {
    padding: 1 0;
}

/* --- dice --- */

DiceScreen {
    align: center middle;
    background: $background 60%;
}

#dice-box {  /* the same height from the roll to the verdict: the Fate button's row is kept for it from the start */
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: double $secondary;
    border-title-color: $secondary;
    border-title-style: bold;
    padding: 1 2;
    background: $surface;
}

#dice-box > Static {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#dice-faces {
    margin: 1 0 0 0;
}

/* A big screen's dice box (ui/dice.py ROOMY): the die and what's at stake beside it, then the row of faces, the sum
   and the verdict stamped big. Its width is set as it opens. */
#dice-box.roomy {
    border-title-align: center;
}

#dice-main {
    width: 100%;
    height: auto;
    align: center middle;
    margin: 1 0 0 0;
}

#dice-main > #dice-faces {
    width: auto;
    margin: 0 4 0 0;
}

#dice-main > #dice-stakes {
    width: auto;
    max-width: 60;
    height: auto;
    text-align: left;
    content-align: left middle;
}

/* A short, wide screen's (a phone on its side, ui/dice.py SIDE): the die on the left, the words beside it. */
#dice-words {
    width: 1fr;
    height: auto;
}

#dice-words > Static {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#dice-box.side #dice-main > #dice-faces {
    margin: 0 2 0 0;
}

#dice-strip {
    margin-top: 1;
}

#dice-box.roomy #dice-verdict {
    margin-top: 1;
}

#dice-bonuses, #dice-verdict, #dice-prompt {
    margin-top: 1;
}

#dice-fate {
    visibility: hidden;
    margin-top: 1;
}

#dice-fate.-shown {
    visibility: visible;
}

/* A short screen: no blank lines in the dice box (and on a tiny one a smaller die, see DiceScreen). */
.-short #dice-box, .-tiny #dice-box {
    padding: 0 2;
}

.-short #dice-faces, .-tiny #dice-faces, .-short #dice-bonuses, .-tiny #dice-bonuses, .-short #dice-verdict,
.-tiny #dice-verdict, .-short #dice-prompt, .-tiny #dice-prompt, .-short #dice-fate, .-tiny #dice-fate,
.-short #dice-strip, .-tiny #dice-strip {
    margin: 0;
}

#dice-fate:hover {
    text-style: bold reverse;
}

/* How a roll went (see ui/effects.py): the dice box keeps its colour, the story's frame pulses it. The frame is the
   story's own border, or in the grid layout the box round it (GameScreen.story_frame): only ever recoloured, never a
   second border inside the first (it blinked on and off with every roll, shifting the words in and out). */
#dice-box.tone-great, #story.tone-great, #map.tone-great, #story-box.tone-great {
    border: double $warning;
    border-title-color: $warning;
}

#dice-box.tone-good, #story.tone-good, #story-box.tone-good {
    border: double $success;
    border-title-color: $success;
}

#dice-box.tone-neutral, #story.tone-neutral, #story-box.tone-neutral {
    border: double #c8c8e0;
    border-title-color: #c8c8e0;
}

#dice-box.tone-bad, #story.tone-bad, #story-box.tone-bad {
    border: double $error;
    border-title-color: $error;
}

#dice-box.tone-awful, #story.tone-awful, #story-box.tone-awful {
    border: double #ff2a6d;
    border-title-color: #ff2a6d;
}

GridScreen #story.tone-great, GridScreen #story.tone-good, GridScreen #story.tone-neutral, GridScreen #story.tone-bad,
GridScreen #story.tone-awful {
    border: none;  /* (its frame is #story-box's) */
}

/* --- panels (ui/panels.py Panel) ---
   One box each, of a size class, sized as it opens and never again while it's open: small (as tall as what's in
   it), card (84 wide), wide (as wide as the panel works out), full. A card's or a wide panel's height is set in code
   from the screen's (panel_rows); what changes inside scrolls inside. */

Panel {
    layers: default close;
    align: center middle;
    background: $background 60%;
}

.panel-box {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: double $primary;
    border-title-color: $secondary;
    padding: 1 2;
    background: $surface;
}

.panel-box.small {
    width: 64;
}

.panel-box.model-box {  /* a thing to turn over (ui/model_view.py): its picture, as big as fits, and the keys */
    padding: 0 1;
}

/* A thing that's never been yours before (ui/model_view.py FoundScreen): held up, its model turning as big as the
   card allows over what it is and where it's gone, which scroll if they must; the button stays put under them. */
.panel-box.found-box {
    border: double #ffd166;
    border-title-color: #ffd166;
    border-title-style: bold;
}

#found-banner {
    width: 100%;
    height: auto;
    content-align: center middle;
    margin-bottom: 1;
}

#found-model {
    height: 1fr;
    min-height: 8;
}

#found-picture {
    width: 100%;
    height: 1fr;
    content-align: center middle;
}

#found-words {
    height: auto;
    max-height: 12;
    margin-top: 1;
}

#found-hint {
    width: auto;
    margin-left: 2;
}

#inv-model, .panel-model {  /* a model turning in a picture's place: the pack's, a card's (ui/model_view.py) */
    width: 100%;
}

#model-hint {
    width: 100%;
    height: auto;
    content-align: center middle;
}

.panel-box.parchment {  /* a page of parchment, written in ink (the journal: ui/panels.py JournalScreen) */
    background: #ead4aa;
    color: #3e2731;
    border-title-color: #3e2731;
    border-title-background: #ead4aa;
    scrollbar-background: #e4a672;
    scrollbar-background-hover: #e4a672;
    scrollbar-color: #b86f50;
    scrollbar-color-hover: #733e39;
}

.panel-box.wide {
    width: 100;
}

.-short .panel-box, .-tiny .panel-box {  /* a short screen: no blank lines inside (see panels.box_frame) */
    padding: 0 1;
}

/* A level-up (ui/panels.py LevelUpScreen): your face and what the level gave you, three perk cards, and your sheet
   under them, which scroll; the button that takes the perk looked at stays put under them. */
.panel-box.levelup-box {
    border: double #ffd166;
    border-title-color: #ffd166;
    border-title-style: bold;
}

#levelup-body {
    height: 1fr;
}

#levelup-top {
    height: auto;
}

#levelup-face {
    width: auto;
    height: auto;
    border: round #ffd166;
    border-title-color: #ffb000;
    border-title-align: center;
    padding: 0 1;
    margin-right: 3;
}

#levelup-gains {
    width: 1fr;
    height: auto;
}

.levelup-rule {
    height: auto;
    margin: 1 0 0 0;
}

#levelup-perks {
    height: auto;
    grid-gutter: 0 1;
    grid-rows: auto;
}

.perk-card {
    height: 100%;  /* (a row's cards as tall as its tallest) */
    padding: 0 1;
}

.perk-card:hover, .perk-card.-looking {
    background: $panel;
}

#levelup-take {
    height: auto;
}

#levelup-hint {
    width: 1fr;
}

.stat-card.-changed {
    background: $panel;
}

/* The card of a word in the story (InfoScreen): its words scroll, the action under them stays put. */
.info-box #info-body {
    height: auto;
}

.info-box.card #info-body {
    height: 1fr;
}

.panel-box.abandon-box {
    width: 60;
}

.abandon-box > Static {
    margin-bottom: 1;
}

.abandon-buttons {
    height: auto;
    align: center middle;
}

.abandon-buttons Button {
    margin: 0 1;
}

/* Your things and a shop's: a shelf of tiles that scrolls, beside the one you've picked in full, whose words scroll
   under its picture, and what you can do with it stays put at the bottom. Their widths are set to suit the screen
   (InventoryScreen.plan, ShopScreen.plan). */
#inv-shelf, #shop-shelf {
    height: 100%;
}

#inv-grid, #shop-grid {
    grid-size: 3;
    grid-gutter: 0 1;
    height: auto;
}

.item-tile {  /* an item's picture over its name and a note (ui/panels.py ItemTile) */
    width: 20;
    height: 11;
    border: round $primary-darken-2;
    align-horizontal: center;
}

.item-tile.full {  /* its picture at full size (ui/panels.py TILE) */
    width: 26;
    height: 17;
}

.tile-words {
    width: 100%;
    text-align: center;
}

.item-tile.equipped {
    border: round $secondary-darken-2;
}

#inv-side, #shop-side {
    width: 1fr;
    height: 100%;
    padding-left: 2;
}

/* A phone held upright: the shelf a row of tiles across the top that scrolls sideways, the picked one in full under
   it (InventoryScreen.plan, ShopScreen.plan); the bestiary's list over the creature. */
.-phone .inventory-box, .-phone .shop-box, .-phone .bestiary-box {
    layout: vertical;
}

.-phone #inv-shelf, .-phone #shop-shelf {
    height: 12;
    overflow-x: auto;
    overflow-y: hidden;
}

.-phone #inv-side, .-phone #shop-side {
    width: 100%;
    height: 1fr;
    padding-left: 0;
}

.-phone #beast-list {
    width: 100%;
    height: 8;
}

.-phone #beast-body {
    height: 1fr;
}

#inv-words, #shop-words {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#inv-detail, #shop-detail, #shop-about, #shop-says {
    height: auto;
}

#shop-about {
    margin-top: 1;
}

#shop-chat {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#shop-talk {
    width: auto;
    margin-right: 3;
}

#shop-ask {
    width: auto;
}

#shop-log {
    display: none;  /* (till something's been done at the counter: ShopScreen.told) */
    width: 100%;
    height: auto;
    max-height: 8;
    margin-top: 1;
    border-left: tall #ff4f9a;
    padding-left: 1;
}


#inv-use, #inv-hint, #shop-buy, #shop-barter, #shop-sell, #shop-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.inv-verb {
    width: 100%;
    height: 1;
}

.-short #inv-hint, .-tiny #inv-hint, .-short #shop-barter, .-tiny #shop-barter, .-short #shop-hint,
.-tiny #shop-hint {
    margin-top: 0;
}

#shop-keeper {
    height: 100%;
    padding-right: 2;
}

/* The bestiary: the creatures you've met, and the one you're on in full. */
.panel-box.bestiary-box {
    width: 100;
}

#beast-list {
    width: 28;
    height: 100%;
    background: $surface;
}

#beast-body {
    height: 100%;
}

/* The one way a panel shows what you've picked (after the rules it overrides): framed or barred in the accent
   colour, on the panel colour. The campfire's cards do the same (.unlock-card.-picked). */
.item-tile:focus {
    border: round $accent;
    background: $panel;
}

#beast-list > ListItem.-highlight, #beast-list:focus > ListItem.-highlight {
    color: $accent;
    background: $panel;
    text-style: bold;
}

/* --- campfire hub (ui/hub.py HubScreen) ---
   Picking a card shows what it does in a pane of its own height under the tabs, so nothing moves; the buttons to go
   back down stay at the bottom; on a short screen the fire's smaller and the Hall of Legends keeps a few lines. */

#hub {
    height: 1fr;
}

#hub-left {
    width: 1fr;
    border: double $primary;
    padding: 0 1;
}

#hub-right {
    width: 1fr;
    border: double $secondary-darken-2;
    padding: 0 1;
}

#hub-tabs, #hub-tabs > ContentSwitcher, #hub-tabs TabPane {
    height: 1fr;
}

#hub-tabs TabPane {
    padding: 0;
}

.unlock-grid {
    grid-size: 3;
    grid-gutter: 1;
    grid-rows: auto;
    height: auto;
    padding: 1 0;
}

.unlock-card {  /* a name that wraps keeps its cost under it; the cards in a row stay the same height */
    width: 100%;
    height: 100%;
    min-height: 4;
}

.unlock-card.locked {
    color: $text-muted;
    background: $panel;
}

.unlock-card.owned {
    color: $success;
}

.unlock-card.chosen {
    color: $warning;
    text-style: bold;
}

.unlock-card.-picked {  /* the one whose detail shows (the one selection style: see .item-tile:focus) */
    border-top: tall $accent;
    border-bottom: tall $accent;
}

#unlock-pane {
    dock: bottom;
    height: 8;
}

#unlock-detail {
    height: 1fr;
    margin: 1 0;
}

#unlock-action {
    width: 100%;
}

#campfire {
    width: 100%;
    content-align: center middle;
    text-align: center;
    margin-top: 1;
}

#void-line {
    margin: 1 0;
    text-align: center;
}

#hub-souls {
    text-align: center;
}

#legends-box {
    height: 1fr;
    min-height: 6;
    border: round $primary-darken-2;
    border-title-color: $primary;
    margin-top: 1;
}

#hub-buttons {
    dock: bottom;
    height: auto;
    margin-top: 1;
}

.-short #campfire, .-tiny #campfire, .-short #void-line, .-tiny #void-line, .-short #legends-box,
.-tiny #legends-box, .-tiny .unlock-grid, .-tiny #unlock-detail {
    margin: 0;
}

.-tiny .unlock-grid {
    padding: 0;
}

.-phone #back, .-narrow #back, .-tiny #back {  /* no room for three buttons: Esc is the way to the title (the footer says so) */
    display: none;
}

/* A phone held upright: one column, the fire and the way down on top, the cards two across under it. */
.-phone #hub {
    layout: vertical;
}

.-phone #hub-right {
    dock: top;
    width: 100%;
    height: auto;
}

.-phone #hub-left {
    width: 100%;
    height: 1fr;
}

.-phone #void-line, .-phone #campfire {
    margin: 0;
}

.-phone #legends-box {
    height: 5;
    min-height: 5;
    margin: 0;
}

.-phone #hub-buttons {
    dock: none;
    margin: 0;
}

.-phone .unlock-grid {
    grid-size: 2;
}

.-tiny #unlock-pane {  /* (with no blank lines, the longest card still has room for its name and two lines) */
    height: 7;
}

/* --- end of a run --- */

EndScreen {
    align: center middle;
}

#end-box {
    width: 76;
    max-width: 100%;
    height: auto;
    border: double $secondary;
    padding: 1 2;
}

#end-box > Static {
    width: 100%;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

#end-box > .end-hint {
    height: auto;
    align-horizontal: center;
}

#end-box.-tight {  /* a short screen: no blank lines (see EndScreen.fit) */
    padding: 0 2;
}

#end-box.-tight > Static {
    margin-bottom: 0;
}

.end-hint > Clickable {
    margin: 0 2;
}

#end-card {
    border: round $primary-darken-2;
    padding: 0 1;
}

/* --- the debug screen (ui/debug.py) --- */

.panel-box.debug-box {
    width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0 1;
    border: double $accent;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
}

#debug-tabs {
    height: 1fr;
}

#debug-tabs TabPane {
    height: 1fr;
    padding: 0;
}

DebugTab {
    height: 1fr;
}

.debug-toolbar {
    height: auto;
    margin: 1 0 0 0;
}

.debug-toolbar Button {
    margin-right: 2;
    padding: 0 1;
    background: $panel;
}

.debug-toolbar Button:hover {
    background: $primary-darken-1;
}

.debug-toolbar Button.-primary {
    background: $primary;
}

.debug-status {
    width: 1fr;
    padding-left: 1;
}

#check-progress {
    display: none;
    width: auto;
    margin-right: 1;
}

.debug-split {
    height: 1fr;
    margin-top: 1;
}

.debug-split DataTable {
    width: 1fr;
    height: 1fr;
}

.debug-detail {
    width: 40%;
    min-width: 48;
    height: 1fr;
    border-left: tall $primary-darken-2;
    padding: 0 1;
}

LogTab .debug-detail {
    width: 60%;
}

.debug-sprite {
    height: auto;
    margin-bottom: 1;
}

#three-d-about {
    height: auto;
    max-height: 10;
    margin-top: 1;
}

#state-text, #state-tree {
    width: 1fr;
    height: 1fr;
}

#state-tree {
    border-left: tall $primary-darken-2;
    padding-left: 1;
}

#check-backend {
    width: 22;
    margin-right: 2;
}

#log-filter {
    width: 28;
    margin-right: 2;
}

#check-url {
    width: 1fr;
    margin-right: 2;
}

#check-model {
    width: 1fr;
    margin-right: 2;
}

#test-who {
    width: 1fr;
    margin-right: 2;
}

#test-floor {
    width: 27;  /* (room for "floor 5: The Underbloom") */
    margin-right: 2;
}

#test-kit {
    width: 52;
}

#test-own {
    width: 1fr;
    margin-right: 2;
}

#check-results {
    height: 1fr;
    margin-top: 1;
    border: round $primary-darken-2;
    padding: 0 1;
}

#check-history {
    height: 9;
    margin-top: 1;
}


/* The journal (ui/panels.py JournalScreen): each entry its own line, so one that wraps stays in its column. */
.journal-line {
    padding-left: 0;
}

.journal-roll {
    padding-left: 4;
}

/* The character sheet (ui/panels.py CharacterScreen): stat boxes in a row, then two columns, like a tabletop sheet. */
.sheet-header {
    margin-bottom: 1;
}

#sheet-stats {
    height: auto;
    grid-gutter: 0 1;
    grid-rows: auto;
}

.stat-card {
    height: auto;
    padding: 0 1;
    border-title-align: center;
    text-align: center;
}

#sheet-cols {
    height: auto;
    grid-gutter: 0 3;
    grid-rows: auto;
    margin-top: 1;
}

.sheet-section {
    height: auto;
}

.sheet-growth {
    margin-top: 1;
}
