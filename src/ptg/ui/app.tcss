/* A DOS/CRT look: black glass, phosphor blue frames, amber and hot-pink highlights.

   Every screen, a pop-up's too, has a class for how big the terminal is (ui/app.py PTGApp's breakpoints): -narrow
   or -wide, and -tiny, -short or -tall (below 28 rows, below 34, or from there). On a short screen boxes drop their
   blank lines and the bigger pictures shrink. */

Screen {
    background: $background;
}

ToastRack {  /* at the top right, over the room and the sidebar: never over the choices, the pad or the command line */
    dock: top;
    align: right top;
    margin-bottom: 0;
}

Toast {
    border-left: outer $accent;
    background: $panel;
}

/* --- title, intro, settings --- */

#title-wrap, #intro-wrap, #setup-wrap {
    align: center middle;
}

#splash {
    width: auto;
    color: $primary;
    text-style: bold;
}

#tagline {
    width: auto;
    margin: 1 0;
    color: $text-muted;
}

#menu {
    width: 32;
    height: auto;
}

#menu Button {
    width: 100%;
    margin-bottom: 1;
}

#run-info {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

#menu.with-run #continue {
    margin-bottom: 0;
}

#narrator-info {
    width: auto;
    color: $text-muted;
    margin-top: 1;
}

#intro-box {
    width: 76;
    max-width: 100%;
    height: auto;
    border: double $warning;
    border-title-color: $warning;
    padding: 1 2;
}

#intro-hint {
    margin-top: 1;
    color: $text-muted;
}

/* Mouse players: hints and pills that do something when clicked (ui/widgets.py Clickable). */
Clickable {
    width: auto;
}

Clickable:hover {
    text-style: reverse;
}

/* The ✕ in a panel's border (ui/panels.py CloseButton), placed in code: on a layer of its own, so it takes no room
   from the box (which would sit a row off the middle). */
#close {
    layer: close;
    position: absolute;
    overlay: screen;
    width: 3;
    height: 1;
    color: $secondary;
    background: $surface;
}

#close:hover {
    color: $foreground;
    background: $error;
    text-style: bold;
}

.panel-action {
    margin-top: 1;
    height: auto;
}

.panel-action .card-verb {
    width: auto;
    margin-right: 1;
}

.-short .panel-action, .-tiny .panel-action {
    margin-top: 0;
}

/* A new floor: the card on arrival (ui/panels.py FloorScreen) and the banner left in the story. */
.panel-box.floor-box {
    border: double $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

.floor-box > Static {
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

.-tiny .floor-box > Static {
    margin-bottom: 0;
}

.floor-box > .floor-name {
    margin: 1 0;
}

.floor-header {
    width: 100%;
    height: auto;
    margin: 1 0;
    border-top: heavy $accent;
    border-bottom: heavy $accent;
    text-align: center;
    color: $accent;
}

.secret-banner {  /* a floor's secret room, found (game_screen.secret_banner) */
    width: 100%;
    height: auto;
    margin: 1 0;
    border-top: heavy $warning;
    border-bottom: heavy $warning;
    text-align: center;
}

.secret-banner.shop {  /* a shop, found */
    border-top: heavy $success;
    border-bottom: heavy $success;
}

#setup-box {
    width: 72;
    max-width: 100%;
    height: auto;
    border: double $primary;
    border-title-color: $primary;
    padding: 1 2;
}

#setup-box Label {
    margin-top: 1;
    color: $text-muted;
}

#setup-box Input, #setup-box Select {
    width: 100%;
}

#setup-status {
    margin-top: 1;
    color: $warning;
    height: auto;
}

#setup-buttons {
    height: auto;
    margin-top: 1;
}

#setup-sound {
    height: auto;
}

#setup-sound Select {
    width: 1fr;
    margin-right: 1;
}

#setup-buttons Button {
    margin-right: 2;
}

/* --- game screen --- */

#hud {
    height: 1;
    padding: 0 1;
    background: $surface;
}

#hud.hurt {
    background: $error 45%;
}

#hud.healed {
    background: $success 30%;
}

#hud-row {
    height: 1;
}

#hud {
    width: 1fr;
}

#hud-short {
    display: none;
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $surface;
}

#hud-menu {
    display: none;
    width: 4;
    background: $surface;
    color: $secondary;
    text-style: bold;
}

#main {
    height: 1fr;
}

#left {
    width: 1fr;
}

#stage-box {  /* the room's picture over the story, shaped like a room (ui/plan.py) */
    height: auto;
}

#stage {
    width: auto;
    height: auto;
    border: round $primary-darken-2;
    border-title-color: $secondary;
    border-title-style: bold;
}

#stage.combat {
    border: round $error;
    border-title-color: $error;
}

#stage-art {
    width: auto;
    height: auto;
    text-wrap: nowrap;  /* on a terminal made smaller later, a picture is cropped, not wrapped into a mess */
    text-overflow: clip;
}

#story {
    height: 1fr;
    border: double $primary-darken-2;
    border-title-color: $primary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#side {
    height: 1fr;
}

.panel {
    height: auto;
    border: double $primary-darken-2;
    border-title-color: $secondary;
    padding: 0 1;
}

#here-strip {
    display: none;
}

#map {
    height: auto;
}

#ways {
    display: none;
    height: 1;
    padding: 0 1;
}

.way {
    width: 1fr;
    margin-right: 1;
    text-align: center;
}

#choices {
    height: auto;  /* as many lines as it needs, up to the plan's: the layout fixes the rest (ui/plan.py) */
    border: none;
    border-top: heavy $secondary-darken-2;
    border-title-color: $secondary;
    padding: 0 1;
}

.choice-line {
    height: auto;
    width: 100%;
}

#choices .choice {
    width: auto;
    margin-right: 3;
}

.more {
    color: $secondary;
    text-style: bold;
    width: auto;
}

.choice {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.choice:hover {
    background: $secondary 20%;
}

#dpad {
    width: 17;
    height: 5;
    margin: 0 0 0 6;
    border: round $secondary-darken-2;
}

.dpad-row {
    height: 1;
}

.dpad-key, .dpad-gap {
    width: 1fr;
    height: 1;
    text-align: center;
}

.dpad-key:hover {
    background: $secondary 30%;
}

.dpad-key.off:hover {
    background: transparent;
}

/* --- Here's tiles (ui/here.py) --- */

.here-line {
    height: auto;
    width: 100%;
}

.here-tile {
    padding: 0 1 1 1;
}

.here-chip {
    padding: 0;
}

.here-body {
    height: auto;
    width: 100%;
}

.here-art {
    width: auto;
    height: auto;
}

.here-words {
    width: 1fr;
    height: auto;
    padding-left: 1;
}

.here-name, .here-status {
    width: 100%;
    height: auto;
}

.here-chip .here-name {
    width: auto;
    margin-right: 1;
}

.here-verb-rows {
    height: auto;
    width: 100%;
}

.here-chip .here-verb-rows {
    width: 1fr;
}

.here-verbs {
    height: auto;
    width: 100%;
    layout: horizontal;
}

.verb {
    width: auto;
    margin-right: 1;
    height: 1;
}

.verb:hover {
    text-style: bold;
}

.pick-row, .menu-row {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

/* --- the size classes the plan sets on the game screen (GameScreen.relayout) --- */

GameScreen.one #main {
    layout: vertical;
}

GameScreen.one #side {
    display: none;
}

GameScreen.one #here-strip {
    display: block;
}

GameScreen.one #ways {
    display: block;
}

GameScreen.compact #hud {
    display: none;
}

GameScreen.compact #hud-short, GameScreen.compact #hud-menu {
    display: block;
}

GameScreen.compact Footer {
    display: none;
}

GameScreen.compact #command {
    height: 1;
    border: none;
    padding: 0 1;
}

GameScreen.compact #story, GameScreen.compact #here, GameScreen.compact #here-strip,
GameScreen.compact #stage, GameScreen.compact #map {
    border: none;
    border-top: heavy $primary-darken-2;
}

GameScreen.touch .verb {
    height: 3;
    min-width: 8;
    padding: 0 1;
    margin-right: 2;
    content-align: center middle;
}

GameScreen.touch #ways {
    height: 3;
}

GameScreen.touch .way {
    height: 3;
    background: $panel;
    content-align: center middle;
}

GameScreen.touch .verb:hover, GameScreen.touch .choice:hover {
    background: transparent;
    text-style: none;
}

/* --- the game screen in tabs (ui/tabs.py): an illustrated story book, the words on the left page and the
   pictures on the right, each box in its own colour --- */

TabsScreen { background: #090a13; }
TabsScreen #left { width: 1fr; padding: 0 1 0 1; }
TabsScreen #story { border: double $primary-darken-2; border-title-color: $primary; padding: 0 2 0 1;
                    background: #0b0c18; }
TabsScreen #decide { height: 1fr; border: round $secondary; border-title-color: $secondary;
                     border-title-style: bold; padding: 0 1; background: #12142a; }
TabsScreen #decide.scene { border: round $accent; border-title-color: $accent; }
TabsScreen #choices { height: auto; max-height: 9; border: none; padding: 0; background: #12142a; }
TabsScreen #choices .choice { width: 100%; margin: 0; }
TabsScreen #command { border: none; height: 1fr; min-height: 1; background: #1c2040; padding: 0 1; }
TabsScreen #command:focus { background: #23284e; }
TabsScreen #side { padding: 0 1 0 0; }
TabsScreen #stage-box { height: auto; }
TabsScreen #stage { padding: 0; }
TabsScreen #pane-head { height: 3; padding: 0 1; }
TabsScreen #dpad { width: 11; height: 3; margin: 0 2 0 0; border: none; }
TabsScreen .dpad-key, TabsScreen .dpad-gap { width: 3; }
TabsScreen #ways-words { width: 1fr; height: 3; padding: 0 0 0 1; content-align: left middle; }
TabsScreen #tab-row { height: 1; padding: 0 1; }
TabsScreen #tab-bar { width: 1fr; height: 1; }
TabsScreen #tab-expand { width: 5; height: 1; color: #6c6f99; text-align: right; }
TabsScreen #tab-expand:hover { color: #ffb000; background: #1c2040; }
TabsScreen #pane { height: 1fr; border: round #ffb000; border-title-style: bold; border-subtitle-color: #6c6f99;
                   padding: 0 1; background: #10122a; scrollbar-size-vertical: 1; scrollbar-background: #10122a;
                   scrollbar-color: #2a2d4a; }
TabsScreen #shims { display: none; }
TabsScreen ToastRack { dock: bottom; align: right bottom; }  /* in the decision's box (tabs.py) */
TabsScreen .focus { height: auto; margin-top: 1; }
TabsScreen .focus-art { margin-right: 2; width: auto; }
TabsScreen .focus-side { height: auto; width: 1fr; }
TabsScreen .focus-words { height: auto; }
TabsScreen .focus-verbs { height: auto; margin-top: 1; }
TabsScreen .here-verbs { height: 1; width: auto; }
TabsScreen .here-verbs .verb { width: auto; margin-right: 1; }
TabsScreen .strip { height: auto; margin-top: 1; grid-gutter: 0 1; grid-rows: auto; }
TabsScreen .thumb { width: 12; height: auto; }
TabsScreen .thumb:hover { background: #1c2040; }
TabsScreen .thumb-art { width: 12; height: auto; }
TabsScreen .thumb-mark { height: 1; width: 12; color: #10122a; }
TabsScreen .thumb.picked .thumb-mark { color: #ffb000; }
TabsScreen .plain-line { height: 1; width: auto; margin-top: 1; }
TabsScreen .plain-name { width: auto; margin-right: 1; }
TabsScreen .pane-rule { height: 1; margin: 1 0 0 0; }
TabsScreen .map-holder { width: 100%; align: center middle; }
TabsScreen .pane-map, TabsScreen .small-map { width: auto; height: auto; }
TabsScreen .pane-text { height: auto; }
TabsScreen .pane-gap { height: 1; }
TabsScreen #footer-row { dock: bottom; height: 1; background: $footer-background; }
TabsScreen #footer-row Footer { dock: none; width: 1fr; }
TabsScreen #footer-narrator { width: auto; height: 1; padding: 0 1; color: $text-muted;
                              background: $footer-background; border-left: vkey $foreground 20%; }

/* the story: a bar down the side of what you did and a faint one by the dice; the floor's, a quest's and a shop's
   banners as bands of colour */
TabsScreen .player-line { border-left: outer #ffb000; padding-left: 1; margin-top: 1; }
TabsScreen .mechanic { border-left: outer #23264a; padding-left: 1; }
TabsScreen .narration, TabsScreen .pickup-line, TabsScreen .system-line { padding-left: 2; }
TabsScreen .floor-header { border-top: none; border-bottom: none; background: #2a1030; padding: 1 0; margin: 1 0; }
TabsScreen .quest-banner { border: none; background: #2e2408; padding: 0 2; margin-top: 1; }
TabsScreen .secret-banner { border-top: none; border-bottom: none; background: #2e2408; padding: 1 0; }
TabsScreen .secret-banner.shop { border-top: none; border-bottom: none; background: #0c2a18; }
TabsScreen .continued { border-top: none; border-bottom: none; background: #141a3c; padding: 0; }

.player-line { border-left: outer #ffb000; padding-left: 1; margin-top: 1; }
TabsScreen .mechanic { border-left: outer #23264a; padding-left: 1; }
TabsScreen .narration, TabsScreen .pickup-line, TabsScreen .system-line { padding-left: 2; }
TabsScreen .floor-header { border-top: none; border-bottom: none; background: #2a1030; padding: 1 0; margin: 1 0; }
TabsScreen .quest-banner { border: none; background: #2e2408; padding: 0 2; margin-top: 1; }
TabsScreen .secret-banner { border-top: none; border-bottom: none; background: #2e2408; padding: 1 0; }
TabsScreen .secret-banner.shop { border-top: none; border-bottom: none; background: #0c2a18; }
TabsScreen .continued { border-top: none; border-bottom: none; background: #141a3c; padding: 0; }

.player-line {
    margin-top: 1;
    color: $secondary;
    text-style: bold;
}

.narration {
    color: $foreground;
}

.mechanic {
    height: auto;
}

.turn-marker {
    height: 0;
    margin: 0;
    padding: 0;
}

.pickup-line {
    color: $success;
    text-style: bold;
}

.system-line {
    color: $warning;
    text-style: italic;
}

.recap {
    margin-bottom: 1;
}

.continued {  /* where a run picked up again starts (ui/game_screen.py pick_up_again) */
    width: 100%;
    height: auto;
    margin: 1 0;
    border-top: dashed $primary;
    border-bottom: dashed $primary;
    text-align: center;
    color: $primary;
}

.panel-sprite {  /* a picture in a panel: a monster in the bestiary, a card's picture, the shopkeeper (ui/panels.py) */
    margin-bottom: 1;
}

.card-sprite {
    width: 100%;
    height: auto;
    text-align: center;
}

.say {  /* a character's words, with who is speaking first (game_screen.add_speech) */
    border-left: thick $accent;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}

.quest-banner {
    border: round $secondary;
    color: $secondary;
    text-style: bold;
    padding: 0 1;
    height: auto;
    width: auto;
}

.story-card {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border: heavy $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#choices.scene {
    border-top: heavy $accent;
    border-title-color: $accent;
}

#secrets-list {
    padding: 1 0;
}

/* --- dice --- */

DiceScreen {
    align: center middle;
    background: $background 60%;
}

#dice-box {  /* the same height from the roll to the verdict: the Fate button's row is kept for it from the start */
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: double $secondary;
    border-title-color: $secondary;
    border-title-style: bold;
    padding: 1 2;
    background: $surface;
}

#dice-box > Static {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#dice-faces {
    margin: 1 0 0 0;
}

#dice-bonuses, #dice-verdict, #dice-prompt {
    margin-top: 1;
}

#dice-fate {
    visibility: hidden;
    margin-top: 1;
}

#dice-fate.-shown {
    visibility: visible;
}

/* A short screen: no blank lines in the dice box (and on a tiny one a smaller die, see DiceScreen). */
.-short #dice-box, .-tiny #dice-box {
    padding: 0 2;
}

.-short #dice-faces, .-tiny #dice-faces, .-short #dice-bonuses, .-tiny #dice-bonuses, .-short #dice-verdict,
.-tiny #dice-verdict, .-short #dice-prompt, .-tiny #dice-prompt, .-short #dice-fate, .-tiny #dice-fate {
    margin: 0;
}

#dice-fate:hover {
    text-style: bold reverse;
}

/* How a roll went (see ui/effects.py): the dice box keeps its colour, the story panel pulses it. */
#dice-box.tone-great, #story.tone-great, #map.tone-great {
    border: double $warning;
    border-title-color: $warning;
}

#dice-box.tone-good, #story.tone-good {
    border: double $success;
    border-title-color: $success;
}

#dice-box.tone-neutral, #story.tone-neutral {
    border: double #c8c8e0;
    border-title-color: #c8c8e0;
}

#dice-box.tone-bad, #story.tone-bad {
    border: double $error;
    border-title-color: $error;
}

#dice-box.tone-awful, #story.tone-awful {
    border: double #ff2a6d;
    border-title-color: #ff2a6d;
}

/* --- panels (ui/panels.py Panel) ---
   One box each, of a size class, sized as it opens and never again while it's open: small (as tall as what's in
   it), card (84 wide), wide (as wide as the panel works out), full. A card's or a wide panel's height is set in code
   from the screen's (panel_rows); what changes inside scrolls inside. */

Panel {
    layers: default close;
    align: center middle;
    background: $background 60%;
}

.panel-box {
    width: 84;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    border: double $primary;
    border-title-color: $secondary;
    padding: 1 2;
    background: $surface;
}

.panel-box.small {
    width: 64;
}

.panel-box.wide {
    width: 100;
}

.-short .panel-box, .-tiny .panel-box {  /* a short screen: no blank lines inside (see panels.box_frame) */
    padding: 0 1;
}

/* A level-up's three perk cards (LevelUpScreen). */
.panel-box.levelup-box {
    width: 70;
}

.perk-card {
    height: auto;
    margin-top: 1;
    padding: 0 1;
}

.-tiny .perk-card {
    margin-top: 0;
}

.perk-card:hover {
    background: $panel;
}

/* The card of a word in the story (InfoScreen): its words scroll, the action under them stays put. */
.info-box #info-body {
    height: auto;
}

.info-box.card #info-body {
    height: 1fr;
}

.panel-box.abandon-box {
    width: 60;
}

.abandon-box > Static {
    margin-bottom: 1;
}

.abandon-buttons {
    height: auto;
    align: center middle;
}

.abandon-buttons Button {
    margin: 0 1;
}

/* Your things and a shop's: a shelf of tiles that scrolls, beside the one you've picked in full, whose words scroll
   under its picture, and what you can do with it stays put at the bottom. Their widths are set to suit the screen
   (InventoryScreen.plan, ShopScreen.plan). */
#inv-shelf, #shop-shelf {
    height: 100%;
}

#inv-grid, #shop-grid {
    grid-size: 3;
    grid-gutter: 0 1;
    height: auto;
}

.item-tile {  /* an item's picture over its name and a note (ui/panels.py ItemTile) */
    width: 20;
    height: 11;
    border: round $primary-darken-2;
    align-horizontal: center;
}

.item-tile.full {  /* its picture at full size (ui/panels.py TILE) */
    width: 26;
    height: 17;
}

.tile-words {
    width: 100%;
    text-align: center;
}

.item-tile.equipped {
    border: round $secondary-darken-2;
}

#inv-side, #shop-side {
    width: 1fr;
    height: 100%;
    padding-left: 2;
}

#inv-words, #shop-words {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#inv-detail, #shop-detail, #shop-about, #shop-says {
    height: auto;
}

#shop-about {
    margin-top: 1;
}

#inv-use, #inv-hint, #shop-buy, #shop-barter, #shop-sell, #shop-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.inv-verb {
    width: 100%;
    height: 1;
}

.-short #inv-hint, .-tiny #inv-hint, .-short #shop-barter, .-tiny #shop-barter, .-short #shop-hint,
.-tiny #shop-hint {
    margin-top: 0;
}

#shop-keeper {
    height: 100%;
    padding-right: 2;
}

/* The bestiary: the creatures you've met, and the one you're on in full. */
.panel-box.bestiary-box {
    width: 100;
}

#beast-list {
    width: 28;
    height: 100%;
    background: $surface;
}

#beast-body {
    height: 100%;
}

/* The one way a panel shows what you've picked (after the rules it overrides): framed or barred in the accent
   colour, on the panel colour. The campfire's cards do the same (.unlock-card.-picked). */
.item-tile:focus {
    border: round $accent;
    background: $panel;
}

#beast-list > ListItem.-highlight, #beast-list:focus > ListItem.-highlight {
    color: $accent;
    background: $panel;
    text-style: bold;
}

/* --- campfire hub (ui/hub.py HubScreen) ---
   Picking a card shows what it does in a pane of its own height under the tabs, so nothing moves; the buttons to go
   back down stay at the bottom; on a short screen the fire's smaller and the Hall of Legends keeps a few lines. */

#hub {
    height: 1fr;
}

#hub-left {
    width: 1fr;
    border: double $primary;
    padding: 0 1;
}

#hub-right {
    width: 1fr;
    border: double $secondary-darken-2;
    padding: 0 1;
}

#hub-tabs, #hub-tabs > ContentSwitcher, #hub-tabs TabPane {
    height: 1fr;
}

#hub-tabs TabPane {
    padding: 0;
}

.unlock-grid {
    grid-size: 3;
    grid-gutter: 1;
    grid-rows: auto;
    height: auto;
    padding: 1 0;
}

.unlock-card {  /* a name that wraps keeps its cost under it; the cards in a row stay the same height */
    width: 100%;
    height: 100%;
    min-height: 4;
}

.unlock-card.locked {
    color: $text-muted;
    background: $panel;
}

.unlock-card.owned {
    color: $success;
}

.unlock-card.chosen {
    color: $warning;
    text-style: bold;
}

.unlock-card.-picked {  /* the one whose detail shows (the one selection style: see .item-tile:focus) */
    border-top: tall $accent;
    border-bottom: tall $accent;
}

#unlock-pane {
    dock: bottom;
    height: 8;
}

#unlock-detail {
    height: 1fr;
    margin: 1 0;
}

#unlock-action {
    width: 100%;
}

#campfire {
    width: 100%;
    content-align: center middle;
    text-align: center;
    margin-top: 1;
}

#void-line {
    margin: 1 0;
    text-align: center;
}

#hub-souls {
    text-align: center;
}

#legends-box {
    height: 1fr;
    min-height: 6;
    border: round $primary-darken-2;
    border-title-color: $primary;
    margin-top: 1;
}

#hub-buttons {
    dock: bottom;
    height: auto;
    margin-top: 1;
}

.-short #campfire, .-tiny #campfire, .-short #void-line, .-tiny #void-line, .-short #legends-box,
.-tiny #legends-box, .-tiny .unlock-grid, .-tiny #unlock-detail {
    margin: 0;
}

.-tiny .unlock-grid {
    padding: 0;
}

.-narrow #back {  /* no room for three buttons: Esc is the way to the title (and the footer says so) */
    display: none;
}

.-tiny #unlock-pane {  /* (with no blank lines, the longest card still has room for its name and two lines) */
    height: 7;
}

/* --- end of a run --- */

EndScreen {
    align: center middle;
}

#end-box {
    width: 76;
    max-width: 100%;
    height: auto;
    border: double $secondary;
    padding: 1 2;
}

#end-box > Static {
    width: 100%;
    text-align: center;
    content-align: center middle;
    margin-bottom: 1;
}

#end-box > .end-hint {
    height: auto;
    align-horizontal: center;
}

#end-box.-tight {  /* a short screen: no blank lines (see EndScreen.fit) */
    padding: 0 2;
}

#end-box.-tight > Static {
    margin-bottom: 0;
}

.end-hint > Clickable {
    margin: 0 2;
}

#end-card {
    border: round $primary-darken-2;
    padding: 0 1;
}

/* --- the debug screen (ui/debug.py) --- */

.panel-box.debug-box {
    width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0 1;
    border: double $accent;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
}

#debug-tabs {
    height: 1fr;
}

#debug-tabs TabPane {
    height: 1fr;
    padding: 0;
}

DebugTab {
    height: 1fr;
}

.debug-toolbar {
    height: auto;
    margin: 1 0 0 0;
}

.debug-toolbar Button {
    margin-right: 2;
    padding: 0 1;
    background: $panel;
}

.debug-toolbar Button:hover {
    background: $primary-darken-1;
}

.debug-toolbar Button.-primary {
    background: $primary;
}

.debug-status {
    width: 1fr;
    padding-left: 1;
}

#check-progress {
    display: none;
    width: auto;
    margin-right: 1;
}

.debug-split {
    height: 1fr;
    margin-top: 1;
}

.debug-split DataTable {
    width: 1fr;
    height: 1fr;
}

.debug-detail {
    width: 40%;
    min-width: 48;
    height: 1fr;
    border-left: tall $primary-darken-2;
    padding: 0 1;
}

LogTab .debug-detail {
    width: 60%;
}

.debug-sprite {
    height: auto;
    margin-bottom: 1;
}

#state-text, #state-tree {
    width: 1fr;
    height: 1fr;
}

#state-tree {
    border-left: tall $primary-darken-2;
    padding-left: 1;
}

#check-backend {
    width: 22;
    margin-right: 2;
}

#log-filter {
    width: 28;
    margin-right: 2;
}

#check-url {
    width: 1fr;
    margin-right: 2;
}

#check-model {
    width: 1fr;
    margin-right: 2;
}

#test-who {
    width: 1fr;
    margin-right: 2;
}

#test-floor {
    width: 19;
    margin-right: 2;
}

#test-kit {
    width: 52;
}

#test-own {
    width: 1fr;
    margin-right: 2;
}

#check-results {
    height: 1fr;
    margin-top: 1;
    border: round $primary-darken-2;
    padding: 0 1;
}

#check-history {
    height: 9;
    margin-top: 1;
}


/* The journal (ui/panels.py JournalScreen): each entry its own line, so one that wraps stays in its column. */
.journal-line {
    padding-left: 0;
}

.journal-roll {
    padding-left: 4;
}

/* The character sheet (ui/panels.py CharacterScreen): stat boxes in a row, then two columns, like a tabletop sheet. */
.sheet-header {
    margin-bottom: 1;
}

#sheet-stats {
    height: auto;
    grid-gutter: 0 1;
    grid-rows: auto;
}

.stat-card {
    height: auto;
    padding: 0 1;
    border-title-align: center;
    text-align: center;
}

#sheet-cols {
    height: auto;
    grid-gutter: 0 3;
    grid-rows: auto;
    margin-top: 1;
}

.sheet-section {
    height: auto;
}

.sheet-growth {
    margin-top: 1;
}
